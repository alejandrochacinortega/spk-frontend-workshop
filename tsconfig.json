{
    "compilerOptions": {
        // Which JavaScript version to write, and which browser APIs (document, window...) exist.
        "target": "es2022",
        "lib": ["es2022", "dom", "dom.iterable"],

        // Vite bundles the files, so TypeScript only checks them.
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,

        // Tells TypeScript about Vite extras, like importing a .css file.
        "types": ["vite/client"],

        // Lets us write <h1>...</h1> in .tsx files (JSX).
        "jsx": "react-jsx",

        // All strict checks on.
        "strict": true
    },
    "include": ["src"]
}
